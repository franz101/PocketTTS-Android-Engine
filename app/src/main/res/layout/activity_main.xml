<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                app:cardBackgroundColor="@color/pt_hero_background"
                app:shapeAppearance="?attr/shapeAppearanceCornerExtraLarge">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/hero_content_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pocket_voice_hero" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="136dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_hero_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/app_name"
                            android:textAppearance="?attr/textAppearanceHeadlineMedium"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.86"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:text="@string/app_description"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@android:color/white" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Engine status banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:animateLayoutChanges="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <TextView
                                android:id="@+id/status_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/active_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="8dp"
                        app:chipSpacingVertical="0dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/active_pack_chip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            app:chipIcon="@drawable/ic_translate"
                            app:chipIconTint="?attr/colorPrimary" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/active_voice_chip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            app:chipIcon="@drawable/ic_mic"
                            app:chipIconTint="?attr/colorPrimary" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/status_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/status_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/set_default_button"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/action_set_default"
                        app:icon="@drawable/ic_open_in_new" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Language pack -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.PocketTts.SectionIcon"
                            android:src="@drawable/ic_translate" />

                        <TextView
                            style="@style/Widget.PocketTts.SectionTitle"
                            android:accessibilityHeading="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/language_pack" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/pack_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/selected_pack_hint">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/pack_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.PocketTts.Helper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/language_pack_help" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/import_pack_button"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/action_import_pack"
                            android:tooltipText="@string/import_language_pack"
                            app:icon="@drawable/ic_upload" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/download_packs_button"
                            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_download_packs"
                            android:tooltipText="@string/download_language_packs"
                            app:icon="@drawable/ic_download" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/delete_pack_button"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_delete_pack"
                        android:tooltipText="@string/delete_language_pack"
                        android:textColor="@color/delete_button_tint"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/delete_button_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Voice -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.PocketTts.SectionIcon"
                            android:src="@drawable/ic_mic" />

                        <TextView
                            style="@style/Widget.PocketTts.SectionTitle"
                            android:accessibilityHeading="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/voice" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/voice_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/selected_voice_hint">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/voice_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.PocketTts.Helper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/voice_help" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/import_voice_button"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/action_import_voice"
                        android:tooltipText="@string/import_reference_voice"
                        app:icon="@drawable/ic_upload" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Generation -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.PocketTts.SectionIcon"
                            android:src="@drawable/ic_tune" />

                        <TextView
                            style="@style/Widget.PocketTts.SectionTitle"
                            android:accessibilityHeading="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/generation_parameters" />
                    </LinearLayout>

                    <include
                        android:id="@+id/param_temperature"
                        layout="@layout/param_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <include
                        android:id="@+id/param_lsd"
                        layout="@layout/param_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <include
                        android:id="@+id/param_threads"
                        layout="@layout/param_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <include
                        android:id="@+id/param_pause"
                        layout="@layout/param_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <include
                        android:id="@+id/param_tokens"
                        layout="@layout/param_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_button"
                        style="@style/Widget.Material3.Button.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:minHeight="56dp"
                        android:text="@string/save_selection"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- System -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.PocketTts.SectionIcon"
                            android:src="@drawable/ic_settings" />

                        <TextView
                            style="@style/Widget.PocketTts.SectionTitle"
                            android:accessibilityHeading="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_system" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/read_aloud_button"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/read_aloud"
                        app:icon="@drawable/ic_volume"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_tts_button"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/open_android_tts"
                        app:icon="@drawable/ic_open_in_new"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_button"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/about_app"
                        app:icon="@drawable/ic_info"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
