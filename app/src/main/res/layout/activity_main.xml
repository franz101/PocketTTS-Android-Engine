<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity shell: three tab screens switched in place above a bottom navigation bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/screen_listen" />

        <include
            layout="@layout/screen_voices"
            android:visibility="gone" />

        <include
            layout="@layout/screen_engine"
            android:visibility="gone" />

        <!-- Keeps scrolled content from colliding with the status bar icons. -->
        <View
            android:id="@+id/status_scrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/pt_status_scrim" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pt_outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.PocketTts.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
