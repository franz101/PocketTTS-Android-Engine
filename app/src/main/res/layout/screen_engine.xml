<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_engine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Text.PocketTts.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tab_engine" />

        <TextView
            style="@style/Text.PocketTts.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/engine_subtitle" />

        <!-- Status. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/engine_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/engine_status_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:padding="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/engine_status_title"
                            style="@style/Text.PocketTts.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            tools:text="Pocket TTS is the system voice" />

                        <TextView
                            android:id="@+id/engine_status_body"
                            style="@style/Text.PocketTts.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Apps that use Android text-to-speech speak with Pocket TTS." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/engine_voice_avatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/pt_on_gradient"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.PocketTts.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/selected_voice_hint"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/engine_voice_name"
                            style="@style/Text.PocketTts.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="15sp"
                            tools:text="Alba · English" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_tts_button"
                    style="@style/Widget.PocketTts.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/open_android_tts"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fine-tune (collapsed by default). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/finetune_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/finetune_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/pt_accent_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.PocketTts.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/finetune_title"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/finetune_subtitle"
                            style="@style/Text.PocketTts.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/finetune_subtitle" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/finetune_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/pt_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/finetune_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/pt_outline" />

                    <TextView
                        android:id="@+id/finetune_pack_label"
                        style="@style/Text.PocketTts.Overline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/finetune_applies_to"
                        android:textColor="@color/pt_text_secondary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/finetune_packs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView
                        android:id="@+id/finetune_empty"
                        style="@style/Text.PocketTts.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/finetune_empty"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/param_temperature"
                        layout="@layout/param_slider" />

                    <include
                        android:id="@+id/param_lsd"
                        layout="@layout/param_slider" />

                    <include
                        android:id="@+id/param_threads"
                        layout="@layout/param_slider" />

                    <include
                        android:id="@+id/param_pause"
                        layout="@layout/param_slider" />

                    <include
                        android:id="@+id/param_tokens"
                        layout="@layout/param_slider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/save_settings"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About. -->
        <TextView
            style="@style/Text.PocketTts.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/section_about" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_about"
                    layout="@layout/item_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="@color/pt_outline" />

                <include
                    android:id="@+id/row_licenses"
                    layout="@layout/item_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="@color/pt_outline" />

                <include
                    android:id="@+id/row_project"
                    layout="@layout/item_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="@color/pt_outline" />

                <include
                    android:id="@+id/row_packs"
                    layout="@layout/item_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/engine_footer"
            style="@style/Text.PocketTts.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/pt_text_tertiary"
            tools:text="Pocket TTS 0.5.6 · Runs entirely on this device" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
